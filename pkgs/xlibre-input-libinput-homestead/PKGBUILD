# Based on the AUR xlibre-input-libinput PKGBUILD; built from homestead's fork.
# homestead's submodule points at 7fb6bd7, which is upstream X11Libre master but not yet pushed to the fork:
# fetch it from upstream. The fork carries no changes of its own; switch back to it once it has 7fb6bd7.
pkgname=xlibre-input-libinput-homestead
_commit=7fb6bd7a6945fb69820a2b307f6eae413f0114c9
pkgver=25.0.1.r377.g7fb6bd7
pkgrel=1
pkgdesc="libinput input driver for the XLibre X server (homestead fork)"
arch=('x86_64')
url="https://github.com/ztancrell/xf86-input-libinput"
license=('MIT')
depends=('glibc' 'libinput' 'xlibre-xserver')
makedepends=('git' 'meson' 'libx11' 'libxi' 'xlibre-xserver-devel' 'X-ABI-XINPUT_VERSION=26.0')
provides=('xlibre-input-libinput' 'xf86-input-libinput')
conflicts=('xlibre-input-libinput' 'xf86-input-libinput'
           'X-ABI-XINPUT_VERSION<26' 'X-ABI-XINPUT_VERSION>=27')
source=("git+https://github.com/X11Libre/xf86-input-libinput.git#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd xf86-input-libinput
  printf "%s.r%s.g%s" "25.0.1" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  arch-meson xf86-input-libinput build -D xorg-conf-dir=/usr/share/X11/xorg.conf.d
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 xf86-input-libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
